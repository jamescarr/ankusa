{
  "name": "ankusa",
  "version": "0.2.1",
  "description": "Client SDK for Ankusa deployments. Bundles the claim-check gateway client today; more clients (ingest, admin) land here as they're built.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamescarr/ankusa.git",
    "directory": "packages/sdk-typescript"
  },
  "homepage": "https://github.com/jamescarr/ankusa/tree/main/packages/sdk-typescript#readme",
  "bugs": "https://github.com/jamescarr/ankusa/issues",
  "keywords": [
    "ankusa",
    "webhook",
    "claim-check"
  ],
  "scripts": {
    "generate:types": "openapi-typescript ../ankusa/priv/openapi/claim_check.v1.yaml -o src/claim-check/claim-check-schema.d.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
