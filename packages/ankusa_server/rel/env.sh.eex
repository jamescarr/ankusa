#!/bin/sh
# Sourced by the release scripts before the VM starts (`mix release` renders
# this file).
#
# Distribution stays on so an operator can attach to the running node
# (`docker-entrypoint remote`, `docker-entrypoint rpc EXPR`), and everything it
# listens on is loopback: epmd through ERL_EPMD_ADDRESS, the distribution port
# through `inet_dist_use_interface` in vm.args.eex. Set RELEASE_DISTRIBUTION=none
# to turn it off entirely.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_NODE="${RELEASE_NODE:-ankusa@127.0.0.1}"
export ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
