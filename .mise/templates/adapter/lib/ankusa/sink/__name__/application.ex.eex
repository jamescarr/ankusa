defmodule Ankusa.Sink.<%= @module %>.Application do
  @moduledoc """
  Starts the connection tree (`Ankusa.Sink.Connections`) for the connections
  `Ankusa.Sink.<%= @module %>` opens on demand from `publish/4`. `ankusa` core
  doesn't know this package exists.
  """

  use Application

  @impl true
  def start(_type, _args), do: Ankusa.Sink.Connections.start_link(Ankusa.Sink.<%= @module %>)
end
