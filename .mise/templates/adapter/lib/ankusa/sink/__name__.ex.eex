defmodule Ankusa.Sink.<%= @module %> do
  @moduledoc """
  Publishes delivered hooks to **<%= @module %>**. The value is
  `Ankusa.Sink.Message`: inline up to `:inline_max_bytes`, a claim ticket
  above it.

  `publish/4` (see `Ankusa.Sink.Messaging`) returns `:ok` only once
  <%= @module %> has confirmed the publish; anything else is an
  `{:error, reason}` that the source's `Ankusa.RetryPolicy` retries, then
  dead-letters.

  ## Options

    * `:inline_max_bytes` — the largest body sent inline; larger bodies go
      through the claim check. Defaults to `Ankusa.Sink.Message`'s default.
  """

  use Ankusa.Sink.Messaging

  alias Ankusa.Envelope

  @impl true
  def publish(_payload, %Envelope{}, _ctx, _opts), do: {:error, :not_implemented}
end
