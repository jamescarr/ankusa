#!/usr/bin/env bash
#MISE description="Build one Mix package from source: deps from the shared cache, third-party warnings silenced, ours fatal"
#USAGE arg "[pkg]" help="directory name under packages/ (default: ankusa_server)"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
source "$MISE_PROJECT_ROOT/.mise/lib/mix_cache.sh"
cd "$ROOT"

pkg="${usage_pkg:-ankusa_server}"
dir=$(pkg_dir "$pkg")
kind=$(pkg_kind "$pkg")
case "$kind" in
  hex | docker) ;;
  *) fail "$pkg is not a Mix project (kind: $kind)" ;;
esac

# Restores deps/ and _build/<env>/lib/* from the shared cache (see
# .mise/lib/mix_cache.sh), fetches the delta, compiles only stale deps, and
# leaves the shell in $dir.
env="${MIX_ENV:-dev}"
mix_cache_warm "$dir" "$pkg" "$env"

# Ours: the path deps (core, async_api_spex, the adapters) and the package.
# Mix builds path deps with --no-warnings-as-errors, so their warnings show
# here rather than fail; check:package holds each one at zero.
mix compile --warnings-as-errors

echo "==> $pkg built ($env)"
