#!/usr/bin/env bash
#MISE description="mix format every Mix project; gofmt every Go package; google-java-format every sbt package"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
cd "$ROOT"

for d in $(mix_projects); do
  if [ -f "$d/.formatter.exs" ]; then
    echo "==> $d"
    (cd "$d" && mix format)
  fi
done

for p in $(pkg_names); do
  case "$(pkg_kind "$p")" in
    go)
      d=$(pkg_dir "$p")
      echo "==> $d"
      gofmt -w "$d"
      ;;
    java)
      d=$(pkg_dir "$p")
      echo "==> $d"
      (cd "$d" && sbt --server --batch "javafmtAll")
      ;;
  esac
done
