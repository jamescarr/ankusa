#!/usr/bin/env bash
#MISE description="Perf regression gate: core_bench matrix vs packages/ankusa/bench/baseline.json (p99 > 1.2x or ingest/s < 0.8x fails), plus the self-asserting tenant benches unless BENCH_SKIP_TENANTS=1"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
cd "$ROOT/packages/ankusa"

# Tunables (BENCH_RUNS, BENCH_RUNNER, BENCH_BASELINE, BENCH_REBASELINE) are
# documented at the top of bench/gate.exs. The bench runs under MIX_ENV=test
# (set by the script), so fetch and compile that environment first: compile
# time must not land in the first measured run.
export MIX_ENV=test
mix deps.get --check-locked
mix compile

# The tenant benches moved to `bench:tenants` in CI-7: they assert their own
# flatness and budgets rather than a baseline, so they never belonged on the
# base/branch measurement's critical path, and CI now runs them in the
# `bench-tenant` job beside this one. Locally this task still means everything;
# BENCH_SKIP_TENANTS=1 is the CI job's switch, not a default.
if [ "${BENCH_SKIP_TENANTS:-}" != 1 ] && [ "${BENCH_SKIP_TENANTS:-}" != true ]; then
  mise run bench:tenants
fi
unset MIX_ENV

exec elixir bench/gate.exs
