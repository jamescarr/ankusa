#!/usr/bin/env bash
#MISE description="Every check release:tag runs before tagging: main, CHANGELOG, free tags, unpublished versions, secrets, Hex order"
#USAGE arg "<pkgs>" var=#true help="packages about to be tagged"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
cd "$ROOT"

eval "pkgs=($usage_pkgs)"

pkg_guard_main
secrets=$(gh secret list --json name --jq '.[].name')

for p in "${pkgs[@]}"; do
  dir=$(pkg_dir "$p")
  kind=$(pkg_kind "$p")
  v=$(pkg_version "$p")
  tag=$(pkg_tag "$p" "$v")

  pkg_has_heading "$p" "$v" || fail "$dir/CHANGELOG.md has no '## [$v]' heading; run release:prepare first"
  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then fail "tag $tag already exists locally"; fi
  if git ls-remote --exit-code --tags origin "$tag" >/dev/null 2>&1; then fail "tag $tag already exists on origin"; fi

  if [ "$kind" = go ]; then
    # The Go module proxy resolves `packages/<name>/vX.Y.Z`, a second tag
    # release-go.yml pushes after CI passes: it must not exist yet. That tag,
    # not a proxy probe, is this kind's "already published" check — probing
    # proxy.golang.org before the tag exists caches a 404 for up to about 30
    # minutes, which would fail the publish workflow's own wait.
    go_tag=$(pkg_go_tag "$p" "$v")
    if git ls-remote --exit-code --tags origin "$go_tag" >/dev/null 2>&1; then
      fail "Go module tag $go_tag already exists on origin"
    fi
  else
    code=$(pkg_registry_code "$p" "$v")
    [ "$code" = 404 ] || fail "$p $v is already published (HTTP $code); run release:prepare first"
  fi

  # The publish workflow cannot run without these, and finding out from a
  # failed run after the tag exists is worse than finding out now.
  for s in $(pkg_secrets "$p"); do
    printf '%s\n' "$secrets" | grep -qx "$s" || fail "repo secret $s is not set"
  done

  # Packages that path-depend on core build under :prod, where they resolve
  # `{:ankusa, "~> ..."}` from Hex instead: a tag pushed before core is live
  # dies at `MIX_ENV=prod mix deps.get`. Elixir SDKs do not depend on core at
  # all, so they have no ordering constraint.
  if [ "$kind" = hex ] && [ "$p" != ankusa ] && grep -q '{:ankusa, "' "$ROOT/$dir/mix.exs"; then
    core=$(pkg_version ankusa)
    code=$(pkg_registry_code ankusa "$core")
    [ "$code" = 200 ] ||
      fail "ankusa $core is not on Hex yet — release:tag ankusa first, wait for release:watch ankusa"
  fi

  # Same for a package that depends on `async_api_spex` (core): it builds under
  # :prod, so `{:async_api_spex, "~> ..."}` must already be on Hex.
  if [ "$kind" = hex ] && [ "$p" != async_api_spex ] && grep -q '{:async_api_spex, "' "$ROOT/$dir/mix.exs"; then
    spex=$(pkg_version async_api_spex)
    code=$(pkg_registry_code async_api_spex "$spex")
    [ "$code" = 200 ] ||
      fail "async_api_spex $spex is not on Hex yet — release:tag async_api_spex first, wait for release:watch async_api_spex"
  fi

  printf '  %-18s %s -> %s\n' "$p" "$v" "$tag"
done

# A core tag ships the ack path. The device-mapper drill is the one check that
# catches a hook acked before its fsync, and CI's tmpfs drill cannot. ci.yml's
# `crash drill (power-loss cut, device-mapper)` job runs it on every push to
# main, so this reads that job's verdict for HEAD instead of running it here. A
# runner without device-mapper skips the drill and still passes the job, so the
# drill's own summary line in the log is what counts, not the job's conclusion.
for p in "${pkgs[@]}"; do
  if [ "$p" = ankusa ]; then
    head=$(git rev-parse HEAD)
    run=$(gh run list --workflow ci.yml --commit "$head" --event push --json databaseId --jq '.[0].databaseId // empty')
    [ -n "$run" ] || fail "no ci.yml push run for $head yet: wait for it, then retry"
    job=$(gh run view "$run" --json jobs \
      --jq '.jobs[] | select(.name == "crash drill (power-loss cut, device-mapper)") | "\(.databaseId) \(.status) \(.conclusion)"')
    read -r job_id status conclusion <<<"$job"
    [ -n "${job_id:-}" ] || fail "ci.yml run $run has no device-mapper crash drill job"
    [ "$status" = completed ] || fail "ci.yml run $run: the device-mapper crash drill is still $status: wait for it, then retry"
    [ "${conclusion:-}" = success ] ||
      fail "ci.yml run $run: the device-mapper crash drill is '${conclusion:-missing}', not success: an acked hook may not be safe"
    verdict=$(gh run view --job "$job_id" --log | grep -oE 'acked=[0-9]+ recovered=[0-9]+ missing=0 eio_503=[0-9]+ resumed=true' | tail -n 1 || true)
    [ -n "$verdict" ] ||
      fail "ci.yml run $run: the device-mapper crash drill was skipped (no privileged runner); run scripts/drills/flakey.sh on a host that has one before tagging ankusa"
    echo "  crash drill on device-mapper: ci.yml run $run, $verdict"
  fi
done
