#!/usr/bin/env bash
#MISE description="Bump versions, date the CHANGELOGs, and open the release PR for one or more packages"
#USAGE arg "<bump>" help="patch, minor, major, or an explicit version"
#USAGE arg "<pkgs>" var=#true help="packages to release in one PR"
#USAGE flag "--no-pr" help="commit on a local branch only; no origin/main check, push, or PR"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
cd "$ROOT"

bump="$usage_bump"
no_pr="${usage_no_pr:-false}"
eval "pkgs=($usage_pkgs)"

[ -z "$(git status --porcelain)" ] || fail "working tree is dirty; commit or stash first"
if [ "$no_pr" != true ]; then pkg_guard_main; fi

# Validate every package before touching anything, so a bad one leaves no
# branch and no half-applied edits behind.
dirs=()
news=()
tags=()
kinds=()
for p in "${pkgs[@]}"; do
  dir=$(pkg_dir "$p")
  kind=$(pkg_kind "$p")
  new=$(elixir .mise/lib/release.exs plan "$dir" "$bump") || fail "$p: cannot prepare a '$bump' release"
  tag=$(pkg_tag "$p" "$new")
  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then fail "tag $tag already exists locally"; fi
  if git ls-remote --exit-code --tags origin "$tag" >/dev/null 2>&1; then fail "tag $tag already exists on origin"; fi
  dirs+=("$dir")
  news+=("$new")
  tags+=("$tag")
  kinds+=("$kind")
done

branch="release/${tags[0]}"
if [ ${#tags[@]} -gt 1 ]; then branch="$branch-and-$((${#tags[@]} - 1))-more"; fi
if git rev-parse -q --verify "refs/heads/$branch" >/dev/null; then fail "branch $branch already exists"; fi
git switch -c "$branch"

today=$(date -u +%F)
subject="chore(release):"
sep=" "
i=0
while [ $i -lt ${#pkgs[@]} ]; do
  p="${pkgs[$i]}"
  dir="${dirs[$i]}"
  new="${news[$i]}"
  prev_tag=$(pkg_tag "$p" "$(pkg_version "$p")")
  if ! git rev-parse -q --verify "refs/tags/$prev_tag" >/dev/null; then prev_tag=""; fi

  elixir .mise/lib/release.exs apply "$dir" "$new" "$p" "$prev_tag" "$today"
  if [ "$(pkg_kind "$p")" = npm ]; then
    (cd "$dir" && npm version "$new" --no-git-tag-version --ignore-scripts >/dev/null)
  elif [ "$(pkg_kind "$p")" = python ]; then
    # --no-sync, not --frozen: uv.lock records the package's own version, so
    # the bump has to rewrite it or the next `uv sync --locked` (CI on this PR,
    # then the tag run) fails with "lockfile needs to be updated". --no-sync
    # keeps it from also creating a .venv in the package directory.
    (cd "$dir" && uv version "$new" --no-sync >/dev/null)
  elif [ "$(pkg_kind "$p")" = cargo ]; then
    # Cargo.lock records the crate's own version, so the bump has to rewrite it
    # or the next `cargo build --locked` (CI on this PR, then `cargo publish
    # --locked`) fails. --workspace touches only this crate's lock entries.
    (cd "$dir" && cargo update --workspace --quiet)
  elif [ "$(pkg_kind "$p")" = ruby ]; then
    # release.exs already rewrote lib/**/version.rb. Gemfile.lock records the
    # gem's own version, so relock or the next frozen `bundle install` (CI on
    # this PR, then the tag run) fails.
    (cd "$dir" && bundle lock >/dev/null)
  fi
  printf '  %-18s -> %s\n' "$p" "$new"

  subject="$subject$sep${tags[$i]}"
  sep=", "
  i=$((i + 1))
done

# The examples consume the SDKs by path, and their lockfiles record the
# resolved version, so a bump leaves them stale: `check:examples` on this PR
# fails at `uv sync --locked`, and the npm locks would sit a version behind.
# Refresh only the ecosystems this release touched (Elixir path deps are not
# in mix.lock, so Hex releases need nothing here).
relocked=()
has_kind() {
  local k
  for k in "${kinds[@]}"; do [ "$k" = "$1" ] && return 0; done
  return 1
}

if has_kind python; then
  for f in examples/*/pyproject.toml; do
    [ -f "$f" ] || continue
    d="${f%/pyproject.toml}"
    echo "==> $d: uv lock"
    (cd "$d" && uv lock --quiet) || fail "$d: uv lock failed"
    relocked+=("$d/uv.lock")
  done
fi

if has_kind npm; then
  for f in examples/*/*/package.json; do
    [ -f "$f" ] || continue
    d="${f%/package.json}"
    [ -f "$d/package-lock.json" ] || continue
    echo "==> $d: npm install --package-lock-only"
    (cd "$d" && npm install --package-lock-only --ignore-scripts >/dev/null) ||
      fail "$d: npm install --package-lock-only failed"
    relocked+=("$d/package-lock.json")
  done
fi

git add -- "${dirs[@]}"
# Bash 3.2 + `set -u`: expanding an empty array is an error, hence the guard.
if [ ${#relocked[@]} -gt 0 ]; then git add -- "${relocked[@]}"; fi
git commit -q -m "$subject"
echo "committed \"$subject\" on $branch"

if [ "$no_pr" = true ]; then
  echo "--no-pr: nothing pushed"
  exit 0
fi

body=""
i=0
while [ $i -lt ${#pkgs[@]} ]; do
  body="$body## ${tags[$i]}"$'\n\n'"$(pkg_notes "${pkgs[$i]}" "${news[$i]}")"$'\n\n'
  i=$((i + 1))
done

git push -u origin "$branch"
gh pr create --base main --head "$branch" --title "$subject" --body "$body"
echo
echo "after merge: git switch main && git pull && mise run release:tag ${pkgs[*]}"
