#!/usr/bin/env bash
#MISE description="Every check CI runs: workflows, links, every package, examples, tools"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
cd "$ROOT"

mise run lint:workflows
mise run check:links
for p in $(pkg_names); do
  mise run check:package "$p"
done
mise run check:conformance
mise run check:examples
mise run check:tools
