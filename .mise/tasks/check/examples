#!/usr/bin/env bash
#MISE description="Every example app: locked deps, format, :prod compile, the TypeScript workers' typecheck, the Python worker's lockfile, the Rust worker's fmt/clippy, and the Helm charts' lint/template"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
source "$MISE_PROJECT_ROOT/.mise/lib/mix_cache.sh"
cd "$ROOT"

# dist/ must exist: each worker's `ankusa` dependency is a file: link to the
# SDK source and imports its build output.
for p in $(pkg_names); do
  if [ "$(pkg_kind "$p")" = npm ]; then
    d=$(pkg_dir "$p")
    echo "==> $d"
    (cd "$d" && npm ci && npm run build)
  fi
done

for f in examples/*/*/mix.exs; do
  [ -f "$f" ] || continue
  d="${f%/mix.exs}"
  echo "==> $d"
  (
    cd "$d"
    # Same shared dep cache as `mise run build`: an example used to compile
    # RocksDB's C++ NIF from source here (each app has its own _build). The
    # restore comes before deps.get so the cached deps keep their priv/.
    (MIX_ENV=prod mix_cache_warm "$d" "$d" prod --check-locked)
    mix deps.get --check-locked
    mix deps.unlock --check-unused
    mix hex.audit
    if [ -f .formatter.exs ]; then mix format --check-formatted; fi
    MIX_ENV=prod mix compile --warnings-as-errors
  )
done

for f in examples/*/pyproject.toml; do
  [ -f "$f" ] || continue
  d="${f%/pyproject.toml}"
  echo "==> $d"
  (cd "$d" && uv sync --locked)
done

for f in examples/*/Cargo.toml; do
  [ -f "$f" ] || continue
  d="${f%/Cargo.toml}"
  echo "==> $d"
  (cd "$d" && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings)
done

for f in examples/*/*/package.json; do
  [ -f "$f" ] || continue
  d="${f%/package.json}"
  echo "==> $d"
  (cd "$d" && npm ci && npx tsc --noEmit)
done

for f in examples/*/chart/Chart.yaml; do
  [ -f "$f" ] || continue
  d="${f%/Chart.yaml}"
  echo "==> $d"
  (cd "$d" && helm lint . && helm template demo . >/dev/null)
done
