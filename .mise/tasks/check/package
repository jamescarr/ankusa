#!/usr/bin/env bash
#MISE description="Every CI check for one package; brings its docker-compose.yml up and down around the suite"
#USAGE arg "<pkg>" help="directory name under packages/"
#USAGE flag "--keep-infra" help="leave the package's docker-compose services running afterwards"
#USAGE flag "--lane <lane>" help="Mix packages: 'static' (deps, lint, analysis, docs, build) or 'test' (the suite); no flag runs both"
#USAGE flag "--partition <shard>" help="one shard of the test lane as n/K (e.g. 1/3): MIX_TEST_PARTITION=n with mix test --partitions K --cover, exporting the shard's coverage instead of enforcing the floor; implies --lane test"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
source "$MISE_PROJECT_ROOT/.mise/lib/mix_cache.sh"
cd "$ROOT"

pkg="$usage_pkg"
dir=$(pkg_dir "$pkg")
kind=$(pkg_kind "$pkg")

# The two halves CI runs `ankusa` as, in separate jobs, so the suite no longer
# queues behind dialyzer and a static failure reports in three minutes instead
# of ten. No flag is every step in the original order: `mise run check`,
# `.mise/tasks/check/_default` and every other package's CI job pass none.
lane="${usage_lane:-}"
case "$lane" in
  "") ;;
  static | test)
    [ "$kind" = hex ] || [ "$kind" = docker ] ||
      fail "--lane $lane is the Mix split of check:package; $pkg is $kind"
    ;;
  *) fail "unknown --lane '$lane' (static or test)" ;;
esac

# CI-17: one shard of the test lane. `mix test --partitions K --cover` with
# MIX_TEST_PARTITION=n runs the test files whose position in the sorted file
# list falls on shard n and, because partitioning is on, *exports* its coverage
# to cover/n.coverdata instead of computing a report. So a shard neither
# enforces the package's coverage floor (it only ever saw 1/K of the code) nor
# passes a suite that is under it: the `ankusa-coverage` job merges every export
# with `mix test.coverage`, which is where the floor runs in CI.
partition="${usage_partition:-}"
if [ -n "$partition" ]; then
  shard=${partition%%/*}
  total=${partition##*/}
  case "$shard" in '' | *[!0-9]*) fail "unknown --partition '$partition' (expected n/K, e.g. 1/3)" ;; esac
  case "$total" in '' | *[!0-9]*) fail "unknown --partition '$partition' (expected n/K, e.g. 1/3)" ;; esac
  [ "$shard" -ge 1 ] && [ "$shard" -le "$total" ] ||
    fail "--partition $partition: n must be between 1 and K"
  [ "$total" -ge 2 ] || fail "--partition $partition: K must be at least 2"
  [ "$kind" = hex ] || [ "$kind" = docker ] ||
    fail "--partition is the Mix split of check:package; $pkg is $kind"
  case "$lane" in
    "" | test) lane=test ;;
    *) fail "--partition is one shard of the test lane; it cannot be combined with --lane $lane" ;;
  esac
fi
cd "$dir"

tmp=""
infra=""
testlog=""
cleanup() {
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
  if [ -n "$testlog" ]; then rm -f "$testlog"; fi
  if [ -n "$infra" ]; then docker compose down -v; fi
}
trap cleanup EXIT

# The seed ExUnit randomized this run with, on the CI run's summary page, so a
# flaky ordering failure can be replayed with `mix test --seed <n>`.
record_seed() {
  [ -n "${GITHUB_STEP_SUMMARY:-}" ] || return 0
  local seed label="$pkg"
  [ -z "$partition" ] || label="$pkg shard $partition"
  seed=$(sed -n -E 's/^(Running ExUnit with seed: |Randomized with seed )([0-9]+).*/\2/p' "$testlog" | head -1)
  printf -- '- `%s`: ExUnit seed `%s`\n' "$label" "${seed:-unknown}" >> "$GITHUB_STEP_SUMMARY"
}

# The failing tests by name, where the report survives. `mix test` prints them
# on stdout only, and stdout is what a CI log view or an agent's tool output
# clips; `mix test --failed` is the local recovery and CI cannot use it (a
# fresh VM every run). Parse the `$testlog` that `tee` already captured — never
# re-run the suite — and put up to 10 failures (the `N) test …` line, its
# `file:line` and the first 8 lines of its body) on the run's summary page
# beside the seed, then one compact `Failed: …` line on stdout so even a
# clipped log names them. A green run appends nothing here.
record_failures() {
  local block program compact
  block=$(mktemp) || block=""
  program=""
  compact=""
  if [ -n "$block" ]; then program=$(mktemp) || program=""; fi
  if [ -n "$program" ]; then compact=$(mktemp) || compact=""; fi
  if [ -z "$compact" ]; then
    rm -f "$block" "$program"
    echo "Failed: unknown (could not parse the test log — see the job log)"
    return 0
  fi
  cat > "$program" <<'AWK'
BEGIN {
  esc = sprintf("%c", 27)
  max_fail = 10
  max_body = 8
  max_lines = 60
  fc = 0; cap = 0; want_file = 0; in_body = 0
  total = 0; summary = 0
}
{
  line = $0
  # ExUnit colours the header when it thinks it has a terminal.
  gsub(esc "[[]" "[0-9;]*m", "", line)

  # `  3) test name (Module)` / `  1) doctest module Foo.bar/1 (1) (FooTest)`
  # opens a failure block; the next line is its `file:line`, then its body.
  if (line ~ /^[ \t]*[0-9]+\)[ \t]+(test|doctest) /) {
    idx = line
    sub(/^[ \t]*/, "", idx)
    sub(/\).*/, "", idx)
    if (idx + 0 > total) total = idx + 0
    fc++
    if (fc <= max_fail) {
      cap = fc; hdr[cap] = line; loc[cap] = ""; nb[cap] = 0
      want_file = 1; in_body = 0
    } else {
      cap = 0; want_file = 0; in_body = 0
    }
    next
  }
  if (want_file) {
    if (line ~ /^[ \t]*$/) { want_file = 0; in_body = 0; cap = 0; next }
    loc[cap] = line
    want_file = 0; in_body = 1
    next
  }
  if (in_body) {
    if (line ~ /^[ \t]*$/) { in_body = 0; cap = 0; next }
    if (nb[cap] < max_body) { nb[cap]++; body[cap, nb[cap]] = line }
    next
  }

  # ExUnit's own count, in case no block parsed: `Failed: 3 tests`,
  # `Failed: 1 doctest`, or the older `1 test, 1 failure` summary.
  if (line ~ /^[ \t]*Failed: *[0-9]+/) {
    s = line
    sub(/^[ \t]*Failed: */, "", s)
    sub(/[^0-9].*/, "", s)
    summary = s + 0
  } else if (line ~ /[0-9]+ failures?[ \t]*$/) {
    s = line
    sub(/[ \t]*failures?[ \t]*$/, "", s)
    sub(/.*[^0-9]/, "", s)
    summary = s + 0
  }
}
END {
  if (total < summary) total = summary
  if (total <= 0) exit
  if (fc == 0) {
    msg = "Failed: " total " (names unparsed — see the job log)"
    print msg > compact_file
    print msg > block_file
    exit
  }
  # Bound the page: at most 10 failures and ~60 excerpt lines.
  shown = 0; used = 0
  for (i = 1; i <= fc && i <= max_fail; i++) {
    if (used + 3 + nb[i] > max_lines) break
    used += 3 + nb[i]
    shown = i
  }
  for (i = 1; i <= shown; i++) {
    print hdr[i] > block_file
    if (loc[i] != "") print loc[i] > block_file
    for (j = 1; j <= nb[i]; j++) print body[i, j] > block_file
    print "" > block_file
  }
  printf "Failed: %d (showing %d)\n", total, shown > block_file

  # One compact line for stdout: `Failed: 2 — name (Module) at file:line; …`
  msg = "Failed: " total " — "
  for (i = 1; i <= shown; i++) {
    name = hdr[i]
    sub(/^[ \t]*[0-9]+\)[ \t]+(test|doctest) /, "", name)
    place = loc[i]
    sub(/^[ \t]*/, "", place)
    msg = msg (i > 1 ? "; " : "") name
    if (place != "") msg = msg " at " place
  }
  if (total > shown) msg = msg "; +" (total - shown) " more"
  print msg > compact_file
}
AWK
  awk -v block_file="$block" -v compact_file="$compact" -f "$program" "$testlog" || true
  if [ -s "$block" ] && [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    {
      printf -- '- `%s`: failing tests (names, locations and the head of each failure)\n\n' "$pkg"
      printf '````text\n'
      cat "$block"
      printf '````\n'
    } >> "$GITHUB_STEP_SUMMARY"
  fi
  if [ -s "$compact" ]; then cat "$compact"; fi
  rm -f "$block" "$program" "$compact"
  return 0
}

if [ -f docker-compose.yml ]; then
  echo "==> $pkg: docker compose up"
  docker compose up -d --wait
  if [ "${usage_keep_infra:-false}" != true ]; then infra=1; fi
fi

echo "==> $pkg ($kind${lane:+, $lane lane})"
case "$kind" in
  hex | docker)
    # Deps come from the shared cache `mise run build` keeps (see
    # .mise/lib/mix_cache.sh), restored per env instead of compiled here: a
    # fresh worktree used to compile every dep from source for each env the
    # steps below use — RocksDB's C++ NIF in dev for credo/dialyzer/docs,
    # again in test for the suite — which is what held the repo-wide check's
    # lock for those minutes. The subshells keep MIX_ENV local. Restore comes
    # before `deps.get`: the cache pairs sources with their compiled priv/,
    # while deps.get alone leaves source-only directories. A lane warms only
    # the env its own steps use.
    case "$lane" in
      static) envs="dev" ;;
      test) envs="test" ;;
      *) envs="dev test" ;;
    esac
    for env in $envs; do
      (MIX_ENV="$env" mix_cache_warm "$dir" "$pkg" "$env" --check-locked)
    done
    mix deps.get --check-locked
    if [ "$lane" != test ]; then
      mix deps.unlock --check-unused
      # Retired packages and published security advisories fail the build. CI
      # sets HEX_AUDIT_LOG so the report is uploaded as the `hex-audit-<pkg>`
      # artifact, which is why the audit and its upload live in the static lane.
      if [ -n "${HEX_AUDIT_LOG:-}" ]; then
        mkdir -p "$(dirname "$HEX_AUDIT_LOG")"
        mix hex.audit 2>&1 | tee "$HEX_AUDIT_LOG"
      else
        mix hex.audit
      fi
      mix format --check-formatted
      mix compile --warnings-as-errors
      # Static analysis. The credo config is the repo's .credo.exs; dialyzer's
      # PLTs live under _build (see each mix.exs), which CI caches. The shared
      # cache hands a fresh worktree the toolchain's core PLT, so only this
      # project's dependency PLT is built here.
      mix credo --strict
      mix_plt_restore "$pkg"
      mix dialyzer
      mix_plt_save "$pkg"
      # Plug applications only: the packages that serve HTTP.
      case "$pkg" in
        ankusa | ankusa_server) mix sobelow --exit --skip ;;
      esac
    fi
    if [ "$lane" != static ]; then
      # `--cover` enforces the package's
      # `test_coverage: [summary: [threshold: n]]` floor (core 85, every other
      # package 80). A `--partition` shard exports instead of reporting — see
      # the flag's comment — and the merge job is where the floor runs.
      testlog=$(mktemp)
      status=0
      if [ -n "$partition" ]; then
        # Drop this shard's previous export first: `[ -s ]` below must prove
        # *this* run exported, not that a stale file survived a no-op run.
        rm -f "cover/${partition%%/*}.coverdata"
        MIX_TEST_PARTITION="${partition%%/*}" mix test --cover --partitions "${partition##*/}" \
          2>&1 | tee "$testlog" || status=$?
      else
        mix test --cover 2>&1 | tee "$testlog" || status=$?
      fi
      record_seed
      [ "$status" -eq 0 ] || { record_failures; exit "$status"; }
      if [ -n "$partition" ]; then
        # An empty shard exits 0: ExUnit reports `Result: 0 tests` and is
        # happy, and with an export there is no summary table to notice. The
        # merge job would then merge the remaining shards and pass. Fail here
        # instead, and fail when the export the merge needs is absent.
        result=$(grep -m1 '^Result: ' "$testlog" || true)
        [ -n "$result" ] ||
          fail "$pkg: shard $partition printed no 'Result:' line — an unrun shard is a workflow bug, not a pass"
        ran=$(printf '%s\n' "$result" | sed -n -E 's/^Result: ([0-9]+)(\/[0-9]+)? passed.*/\1/p')
        [ -n "$ran" ] && [ "$ran" -gt 0 ] ||
          fail "$pkg: shard $partition ran no tests ($result) — an empty shard is a workflow bug, not a pass"
        export_file="cover/${partition%%/*}.coverdata"
        [ -s "$export_file" ] ||
          fail "$pkg: shard $partition exported no $export_file — the merged report would be incomplete"
      fi
      # The one package-specific step: async_api_spex is for other projects, so
      # its gate is a project that is not this repo.
      if [ "$pkg" = async_api_spex ]; then scripts/standalone.sh; fi
    fi
    ;;
  npm)
    npm ci
    npm run typecheck
    npm run generate:types
    git diff --exit-code -- src/admin/admin-schema.d.ts src/claim-check/claim-check-schema.d.ts \
      || fail "sdk-typescript: generated OpenAPI types are stale; run 'npm run generate:types' in packages/sdk-typescript and commit"
    npm run build
    npm test
    ;;
  python)
    uv sync --locked
    uv run pytest
    uv run mypy
    ;;
  cargo)
    cargo fmt --check
    cargo clippy --locked --all-targets --all-features -- -D warnings
    cargo test --locked --all-features
    RUSTDOCFLAGS="-D warnings" cargo doc --locked --no-deps --all-features
    ;;
  ruby)
    BUNDLE_FROZEN=true bundle install
    bundle exec rake test
    bundle exec rake standard
    ;;
  go)
    go mod tidy -diff
    unformatted=$(gofmt -l .)
    [ -z "$unformatted" ] || fail "gofmt -w needed: $unformatted"
    go vet ./...
    go test -race -count=1 ./...
    ;;
  php)
    composer validate --strict
    composer install --no-interaction --no-progress
    composer lint
    composer analyse
    composer test
    ;;
  java)
    # One foreground sbt JVM; testFull, not test, because of sbt 2's cache and
    # the external vectors; publish stages the unsigned bundle that
    # release-maven.yml signs.
    rm -rf target/sona-staging
    sbt --server --batch "javafmtCheckAll; testFull; doc; publish"
    ;;
  clojure)
    clojure -M:fmt check src test build.clj
    clojure -M:lint --lint src build.clj --fail-level warning
    clojure -M:lint --lint test --fail-level warning --config '{:linters {:missing-docstring {:level :off} :warn-on-reflection {:level :off}}}'
    # The source namespaces set *warn-on-reflection*; loading them in the test
    # run prints a warning to stderr for any interop call left unhinted.
    tmp=$(mktemp -d)
    clojure -X:test 2>&1 | tee "$tmp/test.log"
    if grep -q 'Reflection warning' "$tmp/test.log"; then fail "reflection warnings in the test run (above)"; fi
    # The jar and POM release-clojars.yml attests and uploads.
    clojure -T:build jar
    ;;
esac

if [ "$kind" = hex ] && [ "$lane" != test ]; then
  mix docs --warnings-as-errors
  # Build the package the way release.yml publishes it, under :prod: Hex
  # rejects path deps, so `ankusa` resolves `async_api_spex` and the adapters
  # resolve `ankusa` from Hex rather than the path dep. Only the tarball is
  # built — no `:prod` tree is compiled or needed, so the static lane warms
  # `dev` alone.
  tmp=$(mktemp -d)
  MIX_ENV=prod mix hex.build --output "$tmp/$pkg.tar"
fi

if [ "$kind" = python ]; then
  # Build the sdist + wheel the way release-python.yml publishes them.
  tmp=$(mktemp -d)
  uv build --out-dir "$tmp"
fi

if [ "$kind" = cargo ]; then
  # Package (and build from the packaged sources) the way release-crates.yml
  # publishes it.
  cargo package --locked --allow-dirty
fi

if [ "$kind" = ruby ]; then
  # Build the gem the way release-ruby.yml publishes it.
  tmp=$(mktemp -d)
  gem build --strict --output "$tmp/$pkg.gem"
fi

if [ "$kind" = php ]; then
  # Build the archive `composer archive` produces from this directory and fail
  # if anything outside the published surface leaked in. Composer applies only
  # .gitattributes export-ignore here (not .gitignore), and `composer install`
  # and `composer lint` above just wrote vendor/ and the tool caches.
  tmp=$(mktemp -d)
  composer archive --format=zip --dir="$tmp" --file=sdk-php
  leaked=$(unzip -Z1 "$tmp/sdk-php.zip" | grep -E '^(vendor|tests|\.phpunit\.cache)/|^\.php-cs-fixer\.cache$' || true)
  [ -z "$leaked" ] || fail "the sdk-php archive ships files it must not: $(echo $leaked)"
fi

if [ "$kind" = java ]; then
  # The staged bundle is exactly what release-maven.yml signs and uploads.
  group=$(_pkg_sbt_setting "$dir" organization)
  artifact=$(_pkg_sbt_setting "$dir" name)
  v=$(pkg_version "$pkg")
  staged="target/sona-staging/${group//.//}/$artifact/$v"
  for suffix in .jar -sources.jar -javadoc.jar .pom -cyclonedx.json; do
    [ -f "$staged/$artifact-$v$suffix" ] || fail "publish staged no $artifact-$v$suffix"
  done
  jar="$staged/$artifact-$v.jar"
  unzip -p "$jar" META-INF/MANIFEST.MF | grep -q '^Automatic-Module-Name: io.github.jamescarr.ankusa' ||
    fail "$jar has no Automatic-Module-Name"
  javap -v -cp "$jar" io.github.jamescarr.ankusa.ClientOptions | grep -q 'major version: 61' ||
    fail "$jar is not Java 17 bytecode"
  if grep -qi scala "$staged/$artifact-$v.pom"; then fail "the POM mentions Scala"; fi
  leaked=$(unzip -Z1 "$jar" | grep -vE '^(META-INF/|io/$|io/github/$|io/github/jamescarr/$|io/github/jamescarr/ankusa/)' || true)
  [ -z "$leaked" ] || fail "the jar ships files outside io/github/jamescarr/ankusa: $(echo $leaked)"
fi

if [ "$kind" = clojure ]; then
  lib=$(_pkg_clj_lib "$dir")
  artifact=${lib#*/}
  v=$(pkg_version "$pkg")
  jar="target/$artifact-$v.jar"
  pom="target/classes/META-INF/maven/$lib/pom.xml"
  [ -f "$jar" ] && [ -f "$pom" ] || fail "clojure -T:build jar left no $jar and $pom"
  grep -q "<groupId>${lib%/*}</groupId>" "$pom" && grep -q "<artifactId>$artifact</artifactId>" "$pom" ||
    fail "$pom does not carry the coordinate $lib"
  # A build-tool dependency in the POM would be pulled into every consumer.
  if grep -Eq 'cljfmt|clj-kondo|test-runner|tools.build|deps-deploy' "$pom"; then
    fail "$pom lists a build or test tool as a dependency"
  fi
  leaked=$(unzip -Z1 "$jar" | grep -vE '^(META-INF/|ankusa/$|ankusa/sdk/)' || true)
  [ -z "$leaked" ] || fail "the jar ships files outside ankusa/sdk: $(echo $leaked)"
fi
