#!/usr/bin/env bash
#MISE description="Every CI check for one package; brings its docker-compose.yml up and down around the suite"
#USAGE arg "<pkg>" help="directory name under packages/"
#USAGE flag "--keep-infra" help="leave the package's docker-compose services running afterwards"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
cd "$ROOT"

pkg="$usage_pkg"
dir=$(pkg_dir "$pkg")
kind=$(pkg_kind "$pkg")
cd "$dir"

tmp=""
infra=""
cleanup() {
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
  if [ -n "$infra" ]; then docker compose down -v; fi
}
trap cleanup EXIT

if [ -f docker-compose.yml ]; then
  echo "==> $pkg: docker compose up"
  docker compose up -d --wait
  if [ "${usage_keep_infra:-false}" != true ]; then infra=1; fi
fi

echo "==> $pkg ($kind)"
case "$kind" in
  hex | docker)
    mix deps.get --check-locked
    mix deps.unlock --check-unused
    # Retired packages and published security advisories fail the build.
    mix hex.audit
    mix format --check-formatted
    mix compile --warnings-as-errors
    mix test
    ;;
  npm)
    npm ci
    npm run typecheck
    npm run build
    npm test
    ;;
  python)
    uv sync --locked
    uv run pytest
    uv run mypy
    ;;
  cargo)
    cargo fmt --check
    cargo clippy --locked --all-targets --all-features -- -D warnings
    cargo test --locked --all-features
    RUSTDOCFLAGS="-D warnings" cargo doc --locked --no-deps --all-features
    ;;
  ruby)
    BUNDLE_FROZEN=true bundle install
    bundle exec rake test
    bundle exec rake standard
    ;;
  go)
    go mod tidy -diff
    unformatted=$(gofmt -l .)
    [ -z "$unformatted" ] || fail "gofmt -w needed: $unformatted"
    go vet ./...
    go test -race -count=1 ./...
    ;;
  php)
    composer validate --strict
    composer install --no-interaction --no-progress
    composer lint
    composer analyse
    composer test
    ;;
  java)
    # One foreground sbt JVM; testFull, not test, because of sbt 2's cache and
    # the external vectors; publish stages the unsigned bundle that
    # release-maven.yml signs.
    rm -rf target/sona-staging
    sbt --server --batch "javafmtCheckAll; testFull; doc; publish"
    ;;
esac

if [ "$kind" = hex ]; then
  mix docs --warnings-as-errors
  # Build the package the way release.yml publishes it, under :prod: Hex
  # rejects path deps, so `ankusa` resolves `async_api_spex` and the adapters
  # resolve `ankusa` from Hex rather than the path dep.
  tmp=$(mktemp -d)
  MIX_ENV=prod mix hex.build --output "$tmp/$pkg.tar"
fi

if [ "$kind" = python ]; then
  # Build the sdist + wheel the way release-python.yml publishes them.
  tmp=$(mktemp -d)
  uv build --out-dir "$tmp"
fi

if [ "$kind" = cargo ]; then
  # Package (and build from the packaged sources) the way release-crates.yml
  # publishes it.
  cargo package --locked --allow-dirty
fi

if [ "$kind" = ruby ]; then
  # Build the gem the way release-ruby.yml publishes it.
  tmp=$(mktemp -d)
  gem build --strict --output "$tmp/$pkg.gem"
fi

if [ "$kind" = php ]; then
  # Build the archive `composer archive` produces from this directory and fail
  # if anything outside the published surface leaked in. Composer applies only
  # .gitattributes export-ignore here (not .gitignore), and `composer install`
  # and `composer lint` above just wrote vendor/ and the tool caches.
  tmp=$(mktemp -d)
  composer archive --format=zip --dir="$tmp" --file=sdk-php
  leaked=$(unzip -Z1 "$tmp/sdk-php.zip" | grep -E '^(vendor|tests|\.phpunit\.cache)/|^\.php-cs-fixer\.cache$' || true)
  [ -z "$leaked" ] || fail "the sdk-php archive ships files it must not: $(echo $leaked)"
fi

if [ "$kind" = java ]; then
  # The staged bundle is exactly what release-maven.yml signs and uploads.
  group=$(_pkg_sbt_setting "$dir" organization)
  artifact=$(_pkg_sbt_setting "$dir" name)
  v=$(pkg_version "$pkg")
  staged="target/sona-staging/${group//.//}/$artifact/$v"
  for suffix in .jar -sources.jar -javadoc.jar .pom -cyclonedx.json; do
    [ -f "$staged/$artifact-$v$suffix" ] || fail "publish staged no $artifact-$v$suffix"
  done
  jar="$staged/$artifact-$v.jar"
  unzip -p "$jar" META-INF/MANIFEST.MF | grep -q '^Automatic-Module-Name: io.github.jamescarr.ankusa' ||
    fail "$jar has no Automatic-Module-Name"
  javap -v -cp "$jar" io.github.jamescarr.ankusa.ClientOptions | grep -q 'major version: 61' ||
    fail "$jar is not Java 17 bytecode"
  if grep -qi scala "$staged/$artifact-$v.pom"; then fail "the POM mentions Scala"; fi
  leaked=$(unzip -Z1 "$jar" | grep -vE '^(META-INF/|io/$|io/github/$|io/github/jamescarr/$|io/github/jamescarr/ankusa/)' || true)
  [ -z "$leaked" ] || fail "the jar ships files outside io/github/jamescarr/ankusa: $(echo $leaked)"
fi
