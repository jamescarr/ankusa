#!/usr/bin/env bash
#MISE description="Every CI check for one package; brings its docker-compose.yml up and down around the suite"
#USAGE arg "<pkg>" help="directory name under packages/"
#USAGE flag "--keep-infra" help="leave the package's docker-compose services running afterwards"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
cd "$ROOT"

pkg="$usage_pkg"
dir=$(pkg_dir "$pkg")
kind=$(pkg_kind "$pkg")
cd "$dir"

tmp=""
infra=""
cleanup() {
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
  if [ -n "$infra" ]; then docker compose down -v; fi
}
trap cleanup EXIT

if [ -f docker-compose.yml ]; then
  echo "==> $pkg: docker compose up"
  docker compose up -d --wait
  if [ "${usage_keep_infra:-false}" != true ]; then infra=1; fi
fi

echo "==> $pkg ($kind)"
case "$kind" in
  hex | docker)
    mix deps.get --check-locked
    mix deps.unlock --check-unused
    mix format --check-formatted
    mix compile --warnings-as-errors
    mix test
    ;;
  npm)
    npm ci
    npm run typecheck
    npm run build
    npm test
    ;;
  python)
    uv sync --locked
    uv run pytest
    uv run mypy
    ;;
  cargo)
    cargo fmt --check
    cargo clippy --locked --all-targets --all-features -- -D warnings
    cargo test --locked --all-features
    RUSTDOCFLAGS="-D warnings" cargo doc --locked --no-deps --all-features
    ;;
  ruby)
    BUNDLE_FROZEN=true bundle install
    bundle exec rake test
    bundle exec rake standard
    ;;
  go)
    go mod tidy -diff
    unformatted=$(gofmt -l .)
    [ -z "$unformatted" ] || fail "gofmt -w needed: $unformatted"
    go vet ./...
    go test -race -count=1 ./...
    ;;
esac

if [ "$kind" = hex ]; then
  mix docs --warnings-as-errors
  # Build the package the way release.yml publishes it. Adapters build under
  # :prod, where they resolve `ankusa` from Hex rather than the path dep.
  tmp=$(mktemp -d)
  if [ "$pkg" = ankusa ]; then
    mix hex.build --output "$tmp/$pkg.tar"
  else
    MIX_ENV=prod mix hex.build --output "$tmp/$pkg.tar"
  fi
fi

if [ "$kind" = python ]; then
  # Build the sdist + wheel the way release-python.yml publishes them.
  tmp=$(mktemp -d)
  uv build --out-dir "$tmp"
fi

if [ "$kind" = cargo ]; then
  # Package (and build from the packaged sources) the way release-crates.yml
  # publishes it.
  cargo package --locked --allow-dirty
fi

if [ "$kind" = ruby ]; then
  # Build the gem the way release-ruby.yml publishes it.
  tmp=$(mktemp -d)
  gem build --strict --output "$tmp/$pkg.gem"
fi
