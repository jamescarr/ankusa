    {
      "id": "signature.error.unpadded_secret",
      "feature": "webhook.verify_signature.errors",
      "operation": "verify_signature",
      "description": "A whsec_ secret is strict, padded base64 (as core decodes it): an unpadded one is invalid_secret, never a key some SDKs accept and others refuse.",
