{
  "cases": [
    {
      "id": "webhook.full",
      "feature": "webhook.parse_headers",
      "operation": "parse_headers",
      "input": {
        "headers": {
          "x-ankusa-id": "01a0",
          "x-ankusa-source": "demo",
          "x-ankusa-tenant": "acme",
          "content-type": "application/json"
        }
      },
      "expect": {
        "ok": {
          "id": "01a0",
          "source": "demo",
          "tenant": "acme",
          "content_type": "application/json"
        }
      }
    },
    {
      "id": "webhook.case_insensitive",
      "feature": "webhook.parse_headers",
      "operation": "parse_headers",
      "input": {
        "headers": {
          "X-Ankusa-Id": "01a0",
          "X-Ankusa-Source": "demo",
          "Content-Type": "text/plain"
        }
      },
      "expect": {
        "ok": {
          "id": "01a0",
          "source": "demo",
          "tenant": null,
          "content_type": "text/plain"
        }
      }
    },
    {
      "id": "webhook.defaults",
      "feature": "webhook.parse_headers",
      "operation": "parse_headers",
      "input": {
        "headers": {
          "x-ankusa-id": "01a0"
        }
      },
      "expect": {
        "ok": {
          "id": "01a0",
          "source": "",
          "tenant": null,
          "content_type": null
        }
      }
    },
    {
      "id": "webhook.missing_id",
      "feature": "webhook.parse_headers",
      "operation": "parse_headers",
      "input": {
        "headers": {
          "x-ankusa-source": "demo"
        }
      },
      "expect": {
        "error": {
          "class": "MissingHookIdError"
        }
      }
    },
    {
      "id": "webhook.empty_id",
      "feature": "webhook.parse_headers",
      "operation": "parse_headers",
      "input": {
        "headers": {
          "x-ankusa-id": ""
        }
      },
      "expect": {
        "error": {
          "class": "MissingHookIdError"
        }
      }
    }
  ]
}
