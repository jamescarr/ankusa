{
  "cases": [
    {
      "id": "health.ok",
      "feature": "claim_check.health",
      "operation": "health",
      "input": {
        "gateway": {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "json": {
              "status": "ok"
            }
          }
        }
      },
      "expect": {
        "ok": {
          "status": "ok"
        },
        "requests": [
          {
            "method": "GET",
            "path": "/health"
          }
        ]
      }
    },
    {
      "id": "health.error.service_unavailable",
      "feature": "claim_check.health",
      "operation": "health",
      "input": {
        "gateway": {
          "status": 503,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "json": {
              "status": "unavailable"
            }
          }
        }
      },
      "expect": {
        "error": {
          "class": "ClaimCheckUnavailableError",
          "retryable": true
        }
      }
    },
    {
      "id": "health.error.non_json",
      "feature": "claim_check.health",
