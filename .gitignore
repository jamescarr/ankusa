# The directory Mix will write compiled artifacts to. Recursive: this repo
# is a mono-repo of multiple Mix projects (packages/*, examples/*/*), each
# with its own _build/.
**/_build/

# If you run "mix test --cover", coverage assets end up here.
**/cover/

# The directory Mix downloads your dependencies sources to.
**/deps/

# Where third-party dependencies like ExDoc output generated docs.
**/doc/

# Temporary files, for example, from tests.
/tmp/
packages/*/tmp/

# Local WAL, segments, quarantine, and DLQ written by the framework at runtime.
packages/*/data/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarballs (built via "mix hex.build").
packages/*/*.tar

# Node (examples/*/worker).
**/node_modules/

# TypeScript / Python / Rust / Ruby SDK build output (built via "npm run
# build" / "npm pack" / "uv build" / "cargo build" / "gem build").
packages/sdk-typescript/dist/
packages/sdk-python/dist/
packages/sdk-rust/target/
examples/*/target/
packages/sdk-ruby/*.gem
packages/sdk-ruby/.bundle/

# Composer (packages/sdk-php): vendored deps, and the tool caches
# (phpunit's cache directory, php-cs-fixer's cache file).
packages/sdk-php/vendor/
packages/sdk-php/.phpunit.cache/
packages/sdk-php/.php-cs-fixer.cache

# sbt (packages/sdk-java): every build output under target/, plus the Eclipse
# project files the jdtls language server reads (written by sbt jdtlsProject)
# and anything an editor leaves behind.
packages/sdk-java/target/
packages/sdk-java/project/target/
packages/sdk-java/project/project/
packages/sdk-java/.bsp/
packages/sdk-java/.project
packages/sdk-java/.classpath
packages/sdk-java/.settings/

# Clojure CLI (packages/sdk-clojure).
packages/sdk-clojure/target/
packages/sdk-clojure/.cpcache/
packages/sdk-clojure/.clj-kondo/.cache/
packages/sdk-clojure/.lsp/
packages/sdk-clojure/.nrepl-port

# Python (packages/sdk-python, examples/quickstart).
**/.venv/
**/__pycache__/
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
*.tgz

# Load-generator output from examples/oban-consumer/run.sh (CSVs + JSON reports).
examples/oban-consumer/.e2e-out/

# Expert (Elixir language server) workspace dirs: a log at the repo root, plus
# build/index caches inside each Mix project it opens (see .omp/lsp.yaml).
**/.expert/
