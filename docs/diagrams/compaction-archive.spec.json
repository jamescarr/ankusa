    {"from": "blob", "to": "idx", "kind": "data", "label": "PUT .idx", "seq": 3},
    {"from": "blob", "to": "manifest", "kind": "data", "label": "rewrite", "seq": 3},
    {"from": "compactor", "to": "catalogue", "kind": "data", "label": "one row per segment", "seq": 4},
    {"from": "compactor", "to": "store", "kind": "data", "label": "clear obligations", "seq": 5, "route": "above"},
    {"from": "retention", "to": "catalogue", "kind": "control", "label": "rows past the cutoff"},
    {"from": "retention", "to": "blob", "kind": "control", "label": "DELETE .seg + .idx"},
