    {"id": "topic", "kind": "p2p-channel", "label": "Your queue or topic", "sub": "your broker's DLQ holds poison messages", "tags": ["key=tenant/source"], "lane": "Queue handoff", "col": 2},
    {"id": "sdk", "kind": "service", "label": "Worker + Ankusa SDK", "sub": "decode → idempotency key → handler", "badges": ["idempotent", "competing:3"], "lane": "Queue handoff", "col": 2},
    {"id": "status-note", "kind": "note", "label": "400 401 403 404 410 413 422 dead-letter at once; any other non-2xx or a timeout is retried, then dead-lettered.", "attach": "deliveries"}
