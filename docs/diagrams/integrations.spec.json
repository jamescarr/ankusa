{
  "title": "Handing hooks to a job framework — HTTP handoff and queue handoff",
  "legend": true,
  "lanes": ["Ankusa", "Oban via HTTP", "Celery via HTTP", "Queue handoff"],
  "nodes": [
    {"id": "provider", "kind": "external-system", "label": "Provider", "lane": "Ankusa", "col": 0},
