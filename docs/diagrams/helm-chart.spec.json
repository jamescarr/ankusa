    {"from": "svc", "to": "deploy", "kind": "rpc", "message": "to a ready pod", "label": "none", "seq": 2},
    {"from": "sts", "to": "pvc", "kind": "data", "label": "/var/lib/ankusa"},
    {"from": "sts", "to": "kafka", "type": "event", "message": "intake record", "label": "dual: 201 = fsync + confirm"},
    {"from": "sts", "to": "bucket", "kind": "data", "label": "segments + backups under <pod>/"},
    {"from": "sts", "to": "sinks", "type": "event", "message": "Sink.Message v1", "label": "dispatch after commit"},
    {"from": "deploy", "to": "sinks", "type": "event", "message": "Sink.Message v1", "label": "in the request, 201 on confirm"},
    {"from": "sinks", "to": "consumers", "type": "event", "message": "Sink.Message v1"},
    {"from": "consumers", "to": "ccsvc", "kind": "rpc", "message": "GET /v1/claims/…"},
    {"from": "ccsvc", "to": "ccgw", "kind": "rpc", "message": "to a pod", "label": ":4001"},
    {"from": "ccgw", "to": "bucket", "kind": "data", "label": "read claim pack"}
  ]
