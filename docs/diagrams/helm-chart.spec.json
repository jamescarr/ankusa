{
  "title": "Helm chart — one release, workload by wal.type",
  "legend": true,
  "groups": [
    {"id": "release", "label": "Helm release", "kind": "deployment"},
    {"id": "intake", "label": "Intake log (dual only)", "kind": "broker"}
  ],
  "nodes": [
    {"id": "providers", "kind": "external-system", "label": "Providers", "sub": "post the catch URL", "col": 0, "row": 0},
    {"id": "svc", "kind": "service", "label": "Service :4000", "sub": "ClusterIP · LoadBalancer optional", "group": "release", "col": 1, "row": 0},
    {"id": "sts", "kind": "service", "label": "StatefulSet", "sub": "wal.type disk | dual · replicas by hand", "badges": ["gateway"], "group": "release", "col": 2, "row": 0},
    {"id": "pvc", "kind": "message-store", "label": "PVC per pod", "sub": "persistence.size · retained on delete", "group": "release", "col": 3, "row": 1},
    {"id": "deploy", "kind": "service", "label": "Deployment", "sub": "wal.type none · emptyDir · HPA", "badges": ["gateway"], "group": "release", "col": 1, "row": 2},
    {"id": "ccsvc", "kind": "service", "label": "Service :4001", "sub": "claim check", "group": "release", "col": 1, "row": 3},
    {"id": "ccgw", "kind": "service", "label": "claim-check Deployment", "sub": "ANKUSA_ROLES=claim_check", "badges": ["gateway"], "group": "release", "col": 2, "row": 3},
    {"id": "sinks", "kind": "external-system", "label": "Sinks", "sub": "your brokers or HTTP", "col": 4, "row": 2},
    {"id": "kafka", "kind": "pubsub-channel", "label": "Intake topic", "sub": "no DLQ: unconfirmed → 503", "tags": ["RF 3", "min.insync.replicas=2"], "group": "intake", "col": 4, "row": 3},
    {"id": "bucket", "kind": "message-store", "label": "S3 / GCS bucket", "sub": "segments · backups · claims", "col": 6, "row": 0},
    {"id": "consumers", "kind": "service", "label": "Consumers", "sub": "redeem claims, never the bucket", "badges": ["idempotent"], "col": 5, "row": 2},
    {"id": "probe-note", "kind": "note", "label": "Probes: startup and liveness GET /health, readiness GET /ready (one failure). The grace period is derived from the drain: 45 s by default.", "attach": "bucket"},
    {"id": "mode-note", "kind": "note", "label": "Every mode: PDB maxUnavailable 1, zone and node spread, NetworkPolicy (4000 open, 4001–4004 to operator namespaces).", "attach": "sinks"}
