{
  "title": "Claim check — large bodies stored in packs, redeemed through the gateway",
  "legend": true,
  "groups": [
    {"id": "stores", "label": "claim_check.stores (ordered or hashed)", "kind": "deployment"}
  ],
  "nodes": [
    {"id": "provider", "kind": "external-system", "label": "Provider", "sub": "Stripe, GitHub, …", "col": 0, "row": 0},
    {"id": "edge", "kind": "service", "label": "Edge", "sub": "verify · commit · 201", "col": 0, "row": 1},
    {"id": "store", "kind": "message-store", "label": "Node store", "sub": "hook + claim ref + lease", "col": 0, "row": 2},
    {"id": "dispatch", "kind": "service", "label": "Dispatch", "sub": "checks a body in once per hook", "badges": ["retry"], "col": 0, "row": 3},
    {"id": "packer", "kind": "claim-check", "label": "Claim check", "sub": "one pack per tenant per batch", "col": 1, "row": 3},
    {"id": "store-a", "kind": "message-store", "label": "Claim store 1", "sub": "claims/tenant=<t>/dt=<day>/<pack>", "group": "stores", "col": 1, "row": 5},
    {"id": "store-b", "kind": "message-store", "label": "Claim store 2", "sub": "failover target · 30 s cooldown", "group": "stores", "col": 2, "row": 5},
    {"id": "queue", "kind": "p2p-channel", "label": "Queue / topic", "sub": "RabbitMQ · Kafka · NATS · SQS · Pub/Sub · no DLQ drawn: failures stay on the node", "tags": ["claim ref + sha256", "at-least-once"], "col": 2, "row": 0},
    {"id": "worker", "kind": "service", "label": "Your worker", "sub": "no object-store credentials", "badges": ["idempotent", "competing"], "col": 2, "row": 1},
    {"id": "front", "kind": "service", "label": "Your auth layer", "sub": "mesh · Envoy · API gateway", "badges": ["gateway"], "col": 2, "row": 2},
    {"id": "gateway", "kind": "service", "label": "Claim gateway :4001", "sub": "role claim_check · read-only · claims:read", "badges": ["gateway"], "col": 2, "row": 3},
    {"id": "redeem-dlq", "kind": "dead-letter-channel", "label": "Worker's DLQ", "sub": "permanent redeem failures", "tags": ["400 · 404 · 410 · 502"], "col": 1, "row": 6},
    {"id": "sweeper", "kind": "channel-purger", "label": "Sweeper", "sub": "LocalFS only · skips leased packs", "col": 0, "row": 4},
    {"id": "integrity-note", "kind": "note", "label": "The gateway checks the pack manifest (502 integrity_mismatch); the worker checks the message's sha256. 503 store_unavailable is retried; 400, 404 and 410 are permanent.", "attach": "redeem-dlq"},
    {"id": "ref-note", "kind": "note", "label": "Ref: urn:ankusa:claim:v1:<tenant>:<claim_id>; v2 adds an expiry and HMAC, redeemed with ?exp=&sig=.", "attach": "sweeper"}
  ],
  "edges": [
    {"from": "provider", "to": "edge", "kind": "rpc", "message": "POST /webhooks/<source>", "label": "201 after fsync", "seq": 1, "route": "straight"},
    {"from": "edge", "to": "store", "kind": "data", "label": "commit", "seq": 2},
    {"from": "store", "to": "dispatch", "kind": "data", "label": "due rows", "seq": 3},
    {"from": "dispatch", "to": "packer", "kind": "data", "label": "body > 64 KiB", "seq": 4},
    {"from": "packer", "to": "store-a", "kind": "data", "label": "conditional PUT of the pack", "seq": 5},
    {"from": "packer", "to": "store-b", "kind": "data", "label": "failover", "seq": 5, "route": "ortho"},
    {"from": "packer", "to": "store", "kind": "data", "label": "ref + sha256", "seq": 6, "route": "ortho"},
    {"from": "dispatch", "to": "queue", "type": "event", "message": "Sink.Message v1", "label": "claim ref only", "seq": 7},
    {"from": "queue", "to": "worker", "type": "event", "message": "Sink.Message v1", "seq": 8},
    {"from": "worker", "to": "front", "kind": "rpc", "message": "GET /v1/claims/{tenant}/{id}", "label": "Bearer token", "seq": 9},
    {"from": "front", "to": "gateway", "kind": "rpc", "message": "GET /v1/claims/{tenant}/{id}", "seq": 10},
    {"from": "gateway", "to": "store-a", "kind": "data", "label": "index bytes", "seq": 11},
    {"from": "gateway", "to": "store-b", "kind": "data", "label": "searched too", "seq": 11},
    {"from": "gateway", "to": "worker", "type": "reply", "message": "200 bytes", "label": "x-ankusa-sha256", "seq": 12, "route": "ortho"},
    {"from": "worker", "to": "redeem-dlq", "kind": "dlq", "label": "permanent"},
    {"from": "sweeper", "to": "store-a", "kind": "control", "label": "delete unleased packs", "route": "ortho"}
  ]
}
