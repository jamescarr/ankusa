    {"from": "http", "to": "receive", "type": "event", "message": "POST", "label": "raw body + webhook-signature"},
    {"from": "receive", "to": "handler", "type": "event", "message": "Hook", "label": "x-ankusa-id + idempotency key"},
    {"from": "operator", "to": "clients", "kind": "control", "label": "from code, not curl"},
