{
  "title": "Routing by content — event type, sink filters, templated addresses",
  "legend": true,
  "nodes": [
    {"id": "provider", "kind": "external-system", "label": "Provider", "sub": "billing events", "col": 0, "row": 0},
    {"id": "ingest", "kind": "service", "label": "Edge.Ingest", "sub": "reads event_type once", "col": 0, "row": 1},
    {"id": "filter", "kind": "message-filter", "label": "HTTP sink filter", "sub": "event_type ∈ [invoice.paid]", "col": 1, "row": 0},
    {"id": "store", "kind": "message-store", "label": "Store", "sub": "one delivery row per selected sink", "col": 1, "row": 1},
    {"id": "dispatch", "kind": "service", "label": "Dispatch", "sub": "renders templates per attempt", "badges": ["retry"], "col": 1, "row": 2},
    {"id": "template", "kind": "content-based-router", "label": "Topic template", "sub": "events.{{ event_type ?? other }}", "col": 1, "row": 3},
    {"id": "paid", "kind": "pubsub-channel", "label": "events.invoice.paid", "sub": "must exist: never auto-created · failures → node DLQ", "tags": ["key=tenant/source", "acks=all"], "col": 2, "row": 1},
    {"id": "other", "kind": "pubsub-channel", "label": "events.other", "sub": "the ?? fallback · failures → node DLQ", "tags": ["key=tenant/source", "acks=all"], "col": 2, "row": 3},
    {"id": "receiver", "kind": "external-system", "label": "Invoices receiver", "sub": "url /t/{{ tenant }}", "col": 2, "row": 0},
    {"id": "dlq", "kind": "dead-letter-channel", "label": "Dead rows", "sub": "missing template var → permanent", "tags": ["node-local"], "col": 0, "row": 2},
    {"id": "filter-note", "kind": "note", "label": "Filters are judged once, at ingest: a sink not selected gets no delivery row. No sink selected → 201 {\"filtered\": true}, nothing stored.", "attach": "ingest"}
  ],
  "edges": [
    {"from": "provider", "to": "ingest", "kind": "rpc", "message": "POST /webhooks/billing", "label": "201 after fsync", "seq": 1},
    {"from": "ingest", "to": "filter", "type": "event", "message": "hook + event_type", "seq": 2},
    {"from": "filter", "to": "store", "kind": "data", "label": "HTTP row: invoice.paid only", "seq": 3},
    {"from": "ingest", "to": "store", "kind": "data", "label": "Kafka row: no filter", "seq": 3, "route": "straight"},
    {"from": "store", "to": "dispatch", "kind": "data", "label": "due rows", "seq": 4},
    {"from": "dispatch", "to": "template", "type": "event", "message": "Sink.Message v1", "label": "rendered from the stored hook", "seq": 5},
    {"from": "template", "to": "paid", "type": "event", "message": "Sink.Message v1", "label": "event_type = invoice.paid", "seq": 6},
    {"from": "template", "to": "other", "type": "event", "message": "Sink.Message v1", "label": "no event_type", "seq": 6},
    {"from": "dispatch", "to": "receiver", "type": "event", "message": "POST /t/acme", "label": "signed", "seq": 5},
    {"from": "dispatch", "to": "dlq", "kind": "dlq", "label": "{:template_missing, var}"}
  ]
}
