{
  "title": "Direct mode — wal.type: none, 201 only when every sink confirms",
  "legend": true,
  "nodes": [
    {"id": "provider", "kind": "external-system", "label": "Provider", "sub": "retries on 5xx or timeout"},
    {"id": "router", "kind": "service", "label": "Edge.Router", "sub": "same refusals before the body"},
    {"id": "ingest", "kind": "service", "label": "Edge.Ingest", "sub": "verify · tenant quota · envelope"},
    {"id": "publish", "kind": "recipient-list", "label": "Edge.Publish", "sub": "every selected sink · one 8 s deadline"},
    {"id": "kafka", "kind": "pubsub-channel", "label": "Kafka topic", "sub": "no DLQ: a failed publish is the 503", "tags": ["acks=all", "key=tenant/source"]},
    {"id": "http", "kind": "external-system", "label": "Your HTTP endpoint", "sub": "2xx = delivered"},
    {"id": "store", "kind": "datastore", "label": "Local store", "sub": "quarantine pen · sources · limits only"},
