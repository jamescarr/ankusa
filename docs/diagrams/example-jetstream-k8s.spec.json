    {"id": "direct", "kind": "service", "label": "ankusa ×2–6", "sub": "wal: none · HPA on CPU 50 %", "badges": ["gateway"], "col": 2, "row": 0},
    {"id": "durable", "kind": "service", "label": "ankusa-durable ×3", "sub": "wal: disk · 1 Gi PVC each", "badges": ["retry", "circuit-breaker"], "col": 2, "row": 2},
