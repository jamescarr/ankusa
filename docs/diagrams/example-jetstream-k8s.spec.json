{
  "title": "JetStream on kind — an autoscaling direct fleet and a durable fleet",
  "legend": true,
  "groups": [
    {"id": "nats", "label": "NATS JetStream (3 nodes)", "kind": "broker"}
  ],
  "nodes": [
    {"id": "panel", "kind": "service", "label": "Control panel", "sub": "sender · flow · tail · chaos", "col": 0, "row": 0},
