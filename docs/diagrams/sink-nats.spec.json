    {"from": "encode", "to": "conn", "type": "event", "message": "Sink.Message v1", "seq": 3},
    {"from": "conn", "to": "stream", "kind": "rpc", "message": "PUBLISH <subject>", "label": "ok on {stream, seq} ack", "seq": 4},
    {"from": "stream", "to": "consumer", "type": "event", "message": "Sink.Message v1", "label": "at-least-once", "seq": 5},
    {"from": "conn", "to": "dlq", "kind": "dlq", "label": "after the retry policy gives up"}
  ]
